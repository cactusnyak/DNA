DATABASE_URL="postgresql://dna_user:dna_password@localhost:5433/dna"
JWT_SECRET="dna-dev-secret-change-me"
PORT=3000
STORAGE_DRIVER="local"

S3_ENDPOINT=""
S3_REGION=""
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_PUBLIC_URL=""
S3_FORCE_PATH_STYLE="false"


YANDEX_CLIENT_ID=""
YANDEX_CLIENT_SECRET=""
YANDEX_REDIRECT_URI="http://localhost:3000/api/auth/oauth/yandex/callback"

WEB_APP_URL="http://localhost:5173"

SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="noreply@dna.ru"
OTP_LOG_CODES="false"

# OTP delivery. Generate OTP_HASH_SECRET with at least 32 random bytes.
OTP_DELIVERY_PROVIDER="console"
OTP_CODE_TTL_SECONDS="300"
OTP_RESEND_COOLDOWN_SECONDS="60"
OTP_MAX_VERIFY_ATTEMPTS="5"
OTP_MAX_SENDS_PER_PHONE_PER_HOUR="5"
OTP_MAX_SENDS_PER_IP_PER_HOUR="15"
OTP_HASH_SECRET="replace-with-a-random-secret-of-at-least-32-characters"

# SMS.RU is backend-only. Keep test mode enabled until sender/template checks pass.
SMS_RU_API_ID=""
SMS_RU_BASE_URL="https://sms.ru"
SMS_RU_SENDER_NAME=""
SMS_RU_OTP_MESSAGE_TEMPLATE="Код для входа в DNA: {code}"
SMS_RU_TEST_MODE="true"
SMS_RU_REQUEST_TIMEOUT_MS="10000"
SMS_RU_WEBHOOK_TOKEN=""
SMS_RU_WEBHOOK_URL=""

# Enable only behind the single trusted Caddy reverse proxy used in production.
TRUST_PROXY="false"

# Must be "true" in production to allow the exceptional owner-only
# permanent (hard) deletion of orders. Defaults to false.
HARD_DELETE_ORDERS_ENABLED="false"
