generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  DEFAULT
  REFERRAL_PARTNER
  SELLER
  ADMIN
  ULTRA_ADMIN
  OWNER
}

enum Currency {
  RUB
}

enum OrderStatus {
  CREATED
  AWAITING_PAYMENT
  PAID
  SHIPPED
  DELIVERED
  CASHBACK_ACCRUED
  CANCELLED
}

enum PaymentAttemptStatus {
  CREATING
  PENDING
  WAITING_FOR_CAPTURE
  SUCCEEDED
  CANCELED
}

enum OversizedDeliveryQuoteStatus {
  PENDING
  QUOTED
  ACCEPTED
  EXPIRED
  CANCELLED
}

enum CatalogCollectionType {
  CATEGORY
  PRODUCT
}

enum AdStatus {
  DRAFT
  PENDING_MODERATION
  PUBLISHED
  REJECTED
  ARCHIVED
}

enum AuthTokenType {
  EMAIL_VERIFICATION
  PASSWORD_RESET
}

enum WarehouseType {
  OWN
  SELLER
  FULFILLMENT
}

enum PackageType {
  BOX
  PALLET
  ENVELOPE
  CRATE
  OTHER
}

enum DeliveryServiceKind {
  DOOR
  PICKUP
  EXPRESS
  CARGO
  MANUAL
}

enum DeliveryQuoteStatus {
  CREATED
  SELECTED
  EXPIRED
  CANCELLED
}

enum ShipmentStatus {
  DRAFT
  WAITING_FOR_ITEMS
  READY
  QUOTING
  BOOKING
  BOOKED
  COURIER_ASSIGNED
  PICKED_UP
  IN_TRANSIT
  DELIVERED
  BOOKING_FAILED
  DELIVERY_FAILED
  CANCELLED
  RETURNING
  RETURNED
  MANUAL_REVIEW
}

enum ShipmentItemFulfillmentStatus {
  PENDING
  PICKING
  PACKED
  READY
  HANDED_OVER
  DELIVERED
  CANCELLED
  RETURNED
}

enum ShipmentStatusSource {
  SYSTEM
  ADMIN
  PROVIDER
  RECONCILIATION
}

model User {
  id             String    @id @default(uuid())
  email          String?   @unique
  nickname       String
  nicknameSuffix String    @unique @default(dbgenerated("gen_random_uuid()"))
  firstName      String?
  lastName       String?
  role           UserRole  @default(DEFAULT)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  passwordHash    String?
  emailVerifiedAt DateTime?
  oauthProvider   String?
  oauthProviderId String?

  patronymic   String?
  phone        String?
  referralCode String?

  avatarId String?
  avatar   Image?  @relation("UserAvatar", fields: [avatarId], references: [id])

  cartItems               CartItem[]
  orders                  Order[]
  ads                     Ad[]
  favourites              Favourite[]
  authTokens              AuthToken[]
  oversizedDeliveryQuotes OversizedDeliveryQuote[]
  deliveryQuotes          DeliveryQuote[]
  shipmentStatusEvents    ShipmentStatusEvent[]    @relation("ShipmentStatusActor")

  invitedReferrals Referral[] @relation("Inviter")
  receivedReferral Referral?  @relation("Invited")
  balance          Balance?

  @@unique([oauthProvider, oauthProviderId])
  @@index([phone])
}

model AuthToken {
  id         String        @id @default(uuid())
  userId     String
  type       AuthTokenType
  tokenHash  String        @unique
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime      @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type, createdAt])
  @@index([expiresAt])
}

model OtpCode {
  id                 String    @id @default(uuid())
  login              String
  type               String
  purpose            String    @default("login")
  codeHash           String?
  expiresAt          DateTime
  verifyAttempts     Int       @default(0)
  consumedAt         DateTime?
  provider           String?
  providerMessageId  String?   @unique
  providerStatusCode Int?
  deliveryStatus     String?
  providerErrorCode  String?
  sentAt             DateTime?
  deliveredAt        DateTime?
  failedAt           DateTime?
  clientIpHash       String?
  createdAt          DateTime  @default(now())

  // Kept nullable for a rolling migration; new code never writes plaintext OTP.
  code String?

  @@index([login])
  @@index([login, createdAt])
  @@index([clientIpHash, createdAt])
}

model Favourite {
  id        String   @id @default(uuid())
  userId    String
  productId String?
  adId      String?
  createdAt DateTime @default(now())

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id], onDelete: Cascade)
  ad      Ad?      @relation(fields: [adId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@unique([userId, adId])
}

model Balance {
  id       String   @id @default(uuid())
  userId   String   @unique
  value    Int
  currency Currency @default(RUB)

  user User @relation(fields: [userId], references: [id])
}

model Image {
  id        String  @id @default(uuid())
  url       String
  sortOrder Int
  alt       String?

  userAvatars  User[]           @relation("UserAvatar")
  categories   MarketCategory[]
  adCategories AdCategory[]
  products     ProductImage[]
  ads          AdImage[]
}

model MarketCategory {
  id        String @id @default(uuid())
  name      String
  slug      String
  sortOrder Int

  description String?
  parentId    String?
  imageId     String?

  isActive    Boolean   @default(true)
  isOversized Boolean   @default(false)
  deletedAt   DateTime?

  parent   MarketCategory?  @relation("MarketCategoryTree", fields: [parentId], references: [id])
  children MarketCategory[] @relation("MarketCategoryTree")

  image    Image?    @relation(fields: [imageId], references: [id])
  products Product[]

  collectionCategories CatalogCollectionCategory[]

  @@map("Category")
}

model Product {
  id                  String   @id @default(uuid())
  categoryId          String
  title               String
  slug                String
  description         Json     @db.JsonB
  price               Int
  sku                 String?  @unique
  purchasePrice       Int?
  additions           Json?    @db.JsonB
  location            Json?    @db.JsonB
  isOversizedOverride Boolean?

  isActive  Boolean   @default(true)
  deletedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  category MarketCategory @relation(fields: [categoryId], references: [id])
  images   ProductImage[]

  cartItems  CartItem[]
  orderItems OrderItem[]
  favourites Favourite[]

  collectionProducts      CatalogCollectionProduct[]
  oversizedDeliveryQuotes OversizedDeliveryQuote[]
  shippingProfile         ProductShippingProfile?
  warehouses              ProductWarehouse[]
  deliveryServices        ProductDeliveryService[]
}

model AdCategory {
  id        String @id @default(uuid())
  name      String
  slug      String
  sortOrder Int

  description String?
  parentId    String?
  imageId     String?

  isActive  Boolean   @default(true)
  deletedAt DateTime?

  parent   AdCategory?  @relation("AdCategoryTree", fields: [parentId], references: [id])
  children AdCategory[] @relation("AdCategoryTree")

  image Image? @relation(fields: [imageId], references: [id])
  ads   Ad[]
}

model Ad {
  id          String   @id @default(uuid())
  categoryId  String
  sellerId    String
  title       String
  slug        String
  description Json     @db.JsonB
  price       Int
  location    Json?    @db.JsonB
  status      AdStatus @default(PENDING_MODERATION)

  contactPhone    String?
  contactTelegram String?
  contactEmail    String?
  contactOther    String?

  isActive    Boolean   @default(true)
  deletedAt   DateTime?
  moderatedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  category   AdCategory  @relation(fields: [categoryId], references: [id])
  seller     User        @relation(fields: [sellerId], references: [id])
  images     AdImage[]
  favourites Favourite[]
  cartItems  CartItem[]
}

model AdImage {
  adId    String
  imageId String

  ad    Ad    @relation(fields: [adId], references: [id])
  image Image @relation(fields: [imageId], references: [id])

  @@id([adId, imageId])
}

model ProductImage {
  productId String
  imageId   String

  product Product @relation(fields: [productId], references: [id])
  image   Image   @relation(fields: [imageId], references: [id])

  @@id([productId, imageId])
}

model CartItem {
  id        String  @id @default(uuid())
  userId    String
  productId String?
  adId      String?
  quantity  Int
  unitPrice Int

  user    User     @relation(fields: [userId], references: [id])
  product Product? @relation(fields: [productId], references: [id])
  ad      Ad?      @relation(fields: [adId], references: [id])

  @@unique([userId, productId])
  @@unique([userId, adId])
}

model Order {
  id String @id @default(uuid())

  userId         String?
  guestSessionId String?

  customerName    String
  customerPhone   String
  customerEmail   String?
  deliveryAddress String
  comment         String?

  status            OrderStatus @default(CREATED)
  totalAmount       Int
  yookassaPaymentId String?

  archivedAt       DateTime?
  archivedByUserId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user            User?            @relation(fields: [userId], references: [id], onDelete: SetNull)
  items           OrderItem[]
  paymentAttempts PaymentAttempt[]
  shipments       Shipment[]

  referralRewards ReferralReward[]
}

model PaymentAttempt {
  id                 String               @id @default(uuid())
  orderId            String
  activeOrderId      String?              @unique
  idempotenceKey     String               @unique
  providerPaymentId  String?              @unique
  status             PaymentAttemptStatus @default(CREATING)
  amount             Int
  currency           Currency             @default(RUB)
  test               Boolean?
  cancellationReason String?
  providerCreatedAt  DateTime?
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, createdAt])
}

model OrderItem {
  id                String  @id @default(uuid())
  orderId           String
  productId         String
  productTitle      String?
  quantity          Int
  baseUnitPrice     Int
  unitPrice         Int
  selectedAdditions Json?   @db.JsonB
  isOversized       Boolean @default(false)
  deliveryQuoteId   String? @unique
  deliveryPrice     Int     @default(0)
  deliverySnapshot  Json?   @db.JsonB

  order         Order                   @relation(fields: [orderId], references: [id])
  product       Product                 @relation(fields: [productId], references: [id])
  deliveryQuote OversizedDeliveryQuote? @relation(fields: [deliveryQuoteId], references: [id])
  shipmentItems ShipmentItem[]
}

model ProductShippingProfile {
  id            String   @id @default(uuid())
  productId     String   @unique
  isFragile     Boolean  @default(false)
  isStackable   Boolean  @default(true)
  ageRestricted Boolean  @default(false)
  handlingNotes String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  product  Product                 @relation(fields: [productId], references: [id], onDelete: Restrict)
  packages ProductPackageProfile[]
}

model ProductPackageProfile {
  id                String      @id @default(uuid())
  shippingProfileId String
  sequence          Int
  name              String?
  type              PackageType
  quantity          Int         @default(1)
  weightGrams       Int
  lengthMillimeters Int
  widthMillimeters  Int
  heightMillimeters Int
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  shippingProfile ProductShippingProfile @relation(fields: [shippingProfileId], references: [id], onDelete: Restrict)

  @@unique([shippingProfileId, sequence])
  @@index([shippingProfileId])
}

model Warehouse {
  id                  String        @id @default(uuid())
  code                String        @unique
  name                String
  type                WarehouseType @default(OWN)
  country             String?
  region              String?
  city                String?
  street              String?
  building            String?
  postalCode          String?
  fullAddress         String?
  latitude            Decimal?      @db.Decimal(9, 6)
  longitude           Decimal?      @db.Decimal(9, 6)
  contactName         String?
  contactPhone        String?
  contactEmail        String?
  timezone            String?
  workingHours        Json?         @db.JsonB
  courierInstructions String?
  loadingAvailable    Boolean       @default(false)
  isActive            Boolean       @default(true)
  isConfigured        Boolean       @default(false)
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  products        ProductWarehouse[]
  providerConfigs WarehouseProviderConfig[]
  deliveryQuotes  DeliveryQuote[]
  shipments       Shipment[]
}

model ProductWarehouse {
  productId   String
  warehouseId String
  isPrimary   Boolean  @default(false)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  product   Product   @relation(fields: [productId], references: [id], onDelete: Restrict)
  warehouse Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Restrict)

  @@id([productId, warehouseId])
  @@index([warehouseId])
}

model DeliveryProvider {
  id        String   @id @default(uuid())
  code      String   @unique
  name      String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  services         DeliveryService[]
  warehouseConfigs WarehouseProviderConfig[]
  quotes           DeliveryQuote[]
  shipments        Shipment[]
}

model DeliveryService {
  id         String              @id @default(uuid())
  providerId String
  code       String
  name       String
  kind       DeliveryServiceKind
  isActive   Boolean             @default(true)
  createdAt  DateTime            @default(now())
  updatedAt  DateTime            @updatedAt

  provider  DeliveryProvider         @relation(fields: [providerId], references: [id], onDelete: Restrict)
  products  ProductDeliveryService[]
  quotes    DeliveryQuote[]
  shipments Shipment[]

  @@unique([providerId, code])
  @@unique([providerId, id])
  @@index([providerId, isActive])
}

model ProductDeliveryService {
  productId         String
  deliveryServiceId String
  isEnabled         Boolean  @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  product         Product         @relation(fields: [productId], references: [id], onDelete: Restrict)
  deliveryService DeliveryService @relation(fields: [deliveryServiceId], references: [id], onDelete: Restrict)

  @@id([productId, deliveryServiceId])
  @@index([deliveryServiceId])
}

model WarehouseProviderConfig {
  id                 String   @id @default(uuid())
  warehouseId        String
  deliveryProviderId String
  externalLocationId String?
  isEnabled          Boolean  @default(false)
  metadata           Json?    @db.JsonB
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  warehouse        Warehouse        @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  deliveryProvider DeliveryProvider @relation(fields: [deliveryProviderId], references: [id], onDelete: Restrict)

  @@unique([warehouseId, deliveryProviderId])
  @@index([deliveryProviderId])
}

model DeliveryQuote {
  id                  String              @id @default(uuid())
  deliveryProviderId  String
  deliveryServiceId   String
  userId              String?
  guestSessionId      String?
  status              DeliveryQuoteStatus @default(CREATED)
  originWarehouseId   String
  originSnapshot      Json                @db.JsonB
  destinationSnapshot Json                @db.JsonB
  cargoSnapshot       Json                @db.JsonB
  providerCost        Int
  customerCharge      Int
  subsidyAmount       Int                 @default(0)
  markupAmount        Int                 @default(0)
  currency            Currency            @default(RUB)
  expiresAt           DateTime
  providerQuoteId     String?
  providerPayload     Json?               @db.JsonB
  fingerprint         String
  selectedAt          DateTime?
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  deliveryProvider DeliveryProvider @relation(fields: [deliveryProviderId], references: [id], onDelete: Restrict)
  deliveryService  DeliveryService  @relation(fields: [deliveryProviderId, deliveryServiceId], references: [providerId, id], onDelete: Restrict)
  user             User?            @relation(fields: [userId], references: [id], onDelete: SetNull)
  originWarehouse  Warehouse        @relation(fields: [originWarehouseId], references: [id], onDelete: Restrict)
  shipment         Shipment?

  @@index([userId, status, expiresAt])
  @@index([guestSessionId, status, expiresAt])
  @@index([deliveryProviderId, providerQuoteId])
  @@index([fingerprint])
}

model Shipment {
  id                  String         @id @default(uuid())
  orderId             String
  deliveryProviderId  String
  deliveryServiceId   String
  deliveryQuoteId     String?        @unique
  originWarehouseId   String
  originSnapshot      Json           @db.JsonB
  destinationSnapshot Json           @db.JsonB
  cargoSnapshot       Json           @db.JsonB
  serviceSnapshot     Json           @db.JsonB
  status              ShipmentStatus @default(DRAFT)
  providerOrderId     String?
  trackingId          String?
  trackingUrl         String?
  providerCost        Int
  customerCharge      Int
  subsidyAmount       Int            @default(0)
  markupAmount        Int            @default(0)
  currency            Currency       @default(RUB)
  idempotencyKey      String         @unique
  providerMetadata    Json?          @db.JsonB
  attemptCount        Int            @default(0)
  lastErrorCode       String?
  lastErrorMessage    String?
  lastAttemptedAt     DateTime?
  bookedAt            DateTime?
  pickedUpAt          DateTime?
  deliveredAt         DateTime?
  cancelledAt         DateTime?
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  order            Order                 @relation(fields: [orderId], references: [id], onDelete: Restrict)
  deliveryProvider DeliveryProvider      @relation(fields: [deliveryProviderId], references: [id], onDelete: Restrict)
  deliveryService  DeliveryService       @relation(fields: [deliveryProviderId, deliveryServiceId], references: [providerId, id], onDelete: Restrict)
  deliveryQuote    DeliveryQuote?        @relation(fields: [deliveryQuoteId], references: [id], onDelete: SetNull)
  originWarehouse  Warehouse             @relation(fields: [originWarehouseId], references: [id], onDelete: Restrict)
  items            ShipmentItem[]
  statusEvents     ShipmentStatusEvent[]

  @@index([orderId])
  @@index([status])
  @@index([deliveryProviderId, providerOrderId])
  @@index([trackingId])
  @@index([status, attemptCount, lastAttemptedAt])
}

model ShipmentItem {
  id                String                        @id @default(uuid())
  shipmentId        String
  orderItemId       String
  quantity          Int
  fulfillmentStatus ShipmentItemFulfillmentStatus @default(PENDING)
  createdAt         DateTime                      @default(now())
  updatedAt         DateTime                      @updatedAt

  shipment  Shipment  @relation(fields: [shipmentId], references: [id], onDelete: Restrict)
  orderItem OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Restrict)

  @@unique([shipmentId, orderItemId])
  @@index([orderItemId])
}

model ShipmentStatusEvent {
  id             String               @id @default(uuid())
  shipmentId     String
  previousStatus ShipmentStatus?
  status         ShipmentStatus
  source         ShipmentStatusSource
  actorUserId    String?
  providerStatus String?
  metadata       Json?                @db.JsonB
  createdAt      DateTime             @default(now())

  shipment Shipment @relation(fields: [shipmentId], references: [id], onDelete: Restrict)
  actor    User?    @relation("ShipmentStatusActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([shipmentId, createdAt])
  @@index([source, createdAt])
}

model OversizedDeliveryQuote {
  id                     String                       @id @default(uuid())
  clientRequestId        String                       @unique
  productId              String
  cartLineKey            String
  userId                 String?
  guestSessionId         String?
  quantity               Int
  dispatchLocation       Json                         @db.JsonB
  destinationRegion      String
  destinationCity        String
  destinationAddress     String
  customerName           String
  customerPhone          String
  customerEmail          String?
  customerComment        String?
  unloadingRequired      Boolean                      @default(false)
  accessRestrictions     String?
  status                 OversizedDeliveryQuoteStatus @default(PENDING)
  confirmedDeliveryPrice Int?
  currency               Currency                     @default(RUB)
  managerComment         String?
  expiresAt              DateTime?
  acceptedAt             DateTime?
  managerNotifiedAt      DateTime?
  managerEmailMessageId  String?
  createdAt              DateTime                     @default(now())
  updatedAt              DateTime                     @updatedAt

  product   Product    @relation(fields: [productId], references: [id])
  user      User?      @relation(fields: [userId], references: [id], onDelete: SetNull)
  orderItem OrderItem?

  @@index([productId, status])
  @@index([cartLineKey, status])
  @@index([userId, createdAt])
  @@index([guestSessionId, createdAt])
}

model ReferralLevel {
  id    String @id @default(uuid())
  grade Int
  name  String

  referrals Referral[]

  @@unique([grade])
}

model Referral {
  id            String   @id @default(uuid())
  inviterUserId String
  invitedUserId String   @unique
  levelId       String
  createdAt     DateTime @default(now())

  inviter User @relation("Inviter", fields: [inviterUserId], references: [id])
  invited User @relation("Invited", fields: [invitedUserId], references: [id])

  level   ReferralLevel    @relation(fields: [levelId], references: [id])
  rewards ReferralReward[]
}

model ReferralReward {
  id         String   @id @default(uuid())
  referralId String
  orderId    String
  amount     Int
  createdAt  DateTime @default(now())

  referral Referral @relation(fields: [referralId], references: [id])
  order    Order    @relation(fields: [orderId], references: [id])
}

model CatalogCollection {
  id          String                @id @default(uuid())
  slug        String                @unique
  type        CatalogCollectionType
  title       String
  description String?
  isActive    Boolean               @default(true)
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt

  categories CatalogCollectionCategory[]
  products   CatalogCollectionProduct[]
}

model CatalogCollectionCategory {
  collectionId String
  categoryId   String
  sortOrder    Int    @default(0)

  collection CatalogCollection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  category   MarketCategory    @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([collectionId, categoryId])
}

model CatalogCollectionProduct {
  collectionId String
  productId    String
  sortOrder    Int    @default(0)

  collection CatalogCollection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  product    Product           @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([collectionId, productId])
}

/// Append-only audit log for privileged / destructive operations.
/// Records are never updated or deleted by application code.
model AuditEvent {
  id          String   @id @default(uuid())
  action      String
  actorUserId String?
  actorRole   String?
  targetType  String
  targetId    String
  reason      String?
  requestId   String?
  metadata    Json?
  createdAt   DateTime @default(now())

  @@index([targetType, targetId])
  @@index([action])
  @@index([createdAt])
}
